{
  "template_name": "Content Engine OS",
  "databases": [
    {
      "name": "Content Repository",
      "properties": [
        {
          "name": "Post Title",
          "type": "title"
        },
        {
          "name": "Platform",
          "type": "select"
        },
        {
          "name": "Status",
          "type": "select"
        },
        {
          "name": "Publish Date",
          "type": "date"
        },
        {
          "name": "Campaign",
          "type": "relation",
          "target_db": "Campaigns & Themes"
        },
        {
          "name": "Brand Partner",
          "type": "relation",
          "target_db": "Brand Partners"
        },
        {
          "name": "Estimated Hours",
          "type": "number"
        },
        {
          "name": "Live URL",
          "type": "url"
        },
        {
          "name": "Published",
          "type": "formula",
          "expression": "prop(\"Status\") == \"Published\""
        }
      ],
      "views": [
        {
          "name": "Editorial Calendar",
          "type": "calendar",
          "date_property": "Publish Date",
          "sorts": [
            {
              "property": "Publish Date",
              "direction": "ascending"
            }
          ]
        },
        {
          "name": "Production Pipeline",
          "type": "board",
          "group_by_property": "Status"
        },
        {
          "name": "Published Library",
          "type": "table",
          "filter": {
            "property": "Status",
            "select": {
              "equals": "Published"
            }
          },
          "sorts": [
            {
              "property": "Publish Date",
              "direction": "descending"
            }
          ]
        }
      ],
      "sample_rows": [
        {
          "Post Title": "10 Minimalist Desk Setups to Boost Productivity",
          "Platform": "YouTube",
          "Status": "Published",
          "Publish Date": "2024-03-01",
          "Campaign": "Spring Workspace Refresh",
          "Brand Partner": "Keychron",
          "Estimated Hours": 12,
          "Live URL": "https://youtube.com/watch?v=sample1"
        },

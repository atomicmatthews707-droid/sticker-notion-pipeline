          "type": "checkbox"
        },
        {
          "name": "Source Reference",
          "type": "url"
        },
        {
          "name": "Related Campaign",
          "type": "relation",
          "target_db": "Campaigns & Themes"
        }
      ],
      "views": [
        {
          "name": "Brainstorm Board",
          "type": "board",
          "group_by_property": "Pillar"
        },
        {
          "name": "Unvalidated Quick List",
          "type": "table",
          "filter": {
            "property": "Validated",
            "checkbox": {
              "equals": false
            }
          }
        },
        {
          "name": "Low Effort Wins",
          "type": "table",
          "filter": {

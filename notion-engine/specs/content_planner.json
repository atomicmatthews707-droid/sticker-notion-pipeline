    {
      "name": "Campaigns & Themes",
      "properties": [
        {
          "name": "Campaign Name",
          "type": "title"
        },
        {
          "name": "Quarter",
          "type": "select"
        },
        {
          "name": "Status",
          "type": "select"
        },
        {
          "name": "Target Deliverables",
          "type": "number"
        },
        {
          "name": "Content Pieces",
          "type": "relation",
          "target_db": "Content Repository"
        },
        {
          "name": "Total Scheduled",
          "type": "rollup",
          "relation_name": "Content Pieces",
          "rollup_property_name": "Post Title",
          "function": "count"
        },
        {
          "name": "Core Message",
          "type": "rich_text"
        }
      ],
      "views": [
        {
          "name": "Active Campaigns",
          "type": "table",
          "filter": {
            "property": "Status",
            "select": {
              "equals": "Active"
            }
          },
          "sorts": [
            {
              "property": "Quarter",
              "direction": "ascending"
            }
          ]
        },
        {
          "name": "Quarterly Roadmap",
          "type": "board",
          "group_by_property": "Quarter"
        },
        {
          "name": "All Campaigns",
          "type": "list"
        }
      ],

    {
      "name": "Daily Logs",
      "properties": [
        {
          "name": "Log Entry",
          "type": "title"
        },
        {
          "name": "Date",
          "type": "date"
        },
        {
          "name": "Habit",
          "type": "relation",
          "target_db": "Habits"
        },
        {
          "name": "Completed",
          "type": "checkbox"
        },
        {
          "name": "Energy Level",
          "type": "select"
        },
        {
          "name": "Notes",
          "type": "rich_text"
        },
        {
          "name": "Day of Week",
          "type": "formula",
          "expression": "formatDate(prop(\"Date\"), \"dddd\")"
        }
      ],
      "views": [
        {
          "name": "Habit Calendar",
          "type": "calendar",
          "date_property": "Date"
        },
        {
          "name": "Today's Checklist",
          "type": "table",
          "sorts": [
            {
              "property": "Date",
              "direction": "descending"
            }
          ]
        },
        {
          "name": "Logs by Energy Level",
          "type": "board",
          "group_by_property": "Energy Level"
        }
      ],

{
  "template_name": "Atomic Habits & Life Architecture OS",
  "databases": [
    {
      "name": "Life Areas",
      "properties": [
        {
          "name": "Pillar Name",
          "type": "title"
        },
        {
          "name": "Identity Statement",
          "type": "rich_text"
        },
        {
          "name": "Focus Category",
          "type": "select"
        },
        {
          "name": "Habits",
          "type": "relation",
          "target_db": "Habits"
        },
        {
          "name": "Total Habits",
          "type": "rollup",
          "relation_name": "Habits",
          "rollup_property_name": "Habit Name",
          "function": "count"
        }
      ],
      "views": [
        {
          "name": "Pillars Overview",
          "type": "gallery"
        },
        {
          "name": "All Pillars",
          "type": "table",
          "sorts": [
            {
              "property": "Pillar Name",
              "direction": "ascending"
            }
          ]
        }
      ],

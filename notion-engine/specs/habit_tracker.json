      ]
    },
    {
      "name": "Habits",
      "properties": [
        {
          "name": "Habit Name",
          "type": "title"
        },
        {
          "name": "Pillar",
          "type": "relation",
          "target_db": "Life Areas"
        },
        {
          "name": "Time of Day",
          "type": "select"
        },
        {
          "name": "Frequency",
          "type": "select"
        },
        {
          "name": "Target Per Week",
          "type": "number"
        },
        {
          "name": "Active",
          "type": "checkbox"
        },
        {
          "name": "Daily Logs",
          "type": "relation",
          "target_db": "Daily Logs"
        },
        {
          "name": "Total Check-ins",
          "type": "rollup",
          "relation_name": "Daily Logs",
          "rollup_property_name": "Completed",
          "function": "checked"
        }
      ],
      "views": [
        {
          "name": "Active Habits",
          "type": "table",
          "filter": {
            "property": "Active",
            "checkbox": {
              "equals": true
            }
          },
          "sorts": [
            {
              "property": "Habit Name",
              "direction": "ascending"
            }
          ]
        },
        {
          "name": "Habits by Time of Day",
          "type": "board",
          "group_by_property": "Time of Day"
        },
        {
          "name": "Habit Directory",
          "type": "list"
        }
      ],
      "sample_rows": [

{
  "template_name": "Ultimate Freelance Invoice & Billing Hub",
  "databases": [
    {
      "name": "Clients",
      "properties": [
        {
          "name": "Client Name",
          "type": "title"
        },
        {
          "name": "Client Status",
          "type": "select"
        },
        {
          "name": "Primary Contact",
          "type": "rich_text"
        },
        {
          "name": "Contact Email",
          "type": "email"
        },
        {
          "name": "Billing Currency",
          "type": "select"
        },
        {
          "name": "Default Payment Terms",
          "type": "select"
        },
        {
          "name": "Projects",
          "type": "relation",
          "target_db": "Projects"
        },
        {
          "name": "Invoices",
          "type": "relation",
          "target_db": "Invoices"
        },
        {
          "name": "Total Invoiced Revenue",
          "type": "rollup",
          "relation_name": "Invoices",
          "rollup_property_name": "Subtotal",
          "function": "sum"
        }
      ],
      "views": [
        {
          "name": "Active Clients",
          "type": "table",
          "filter": {
            "property": "Client Status",
            "select": {
              "equals": "Active"
            }
          },
          "sorts": [
            {
              "property": "Client Name",
              "direction": "ascending"
            }
          ]
        },
        {
          "name": "Client Directory by Status",
          "type": "board",
          "group_by_property": "Client Status"
        },
        {
          "name": "All Clients",
          "type": "table",
          "sorts": [
            {
              "property": "Client Name",
              "direction": "ascending"
            }
          ]
        }
      ],

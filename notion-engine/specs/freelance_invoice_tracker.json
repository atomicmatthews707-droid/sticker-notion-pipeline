    {
      "name": "Invoices",
      "properties": [
        {
          "name": "Invoice Number",
          "type": "title"
        },
        {
          "name": "Client",
          "type": "relation",
          "target_db": "Clients"
        },
        {
          "name": "Project",
          "type": "relation",
          "target_db": "Projects"
        },
        {
          "name": "Status",
          "type": "select"
        },
        {
          "name": "Issue Date",
          "type": "date"
        },
        {
          "name": "Due Date",
          "type": "date"
        },
        {
          "name": "Subtotal",
          "type": "number"
        },
        {
          "name": "Tax Rate Percent",
          "type": "number"
        },
        {
          "name": "Total Due",
          "type": "formula",
          "expression": "prop(\"Subtotal\") * (1 + (prop(\"Tax Rate Percent\") / 100))"
        },
        {
          "name": "Payment Method",
          "type": "select"
        },
        {
          "name": "Days Overdue",
          "type": "formula",
          "expression": "if(prop(\"Status\") == \"Paid\" or empty(prop(\"Due Date\")), 0, if(now() > prop(\"Due Date\"), dateBetween(now(), prop(\"Due Date\"), \"days\"), 0))"
        },
        {
          "name": "Notes",
          "type": "rich_text"
        }
      ],
      "views": [
        {
          "name": "Invoice Pipeline",
          "type": "board",
          "group_by_property": "Status"
        },
        {
          "name": "All Invoices (Ledger)",
          "type": "table",
          "sorts": [
            {
              "property": "Issue Date",
              "direction": "descending"
            }
          ]
        },
        {
          "name": "Payment Calendar",
          "type": "calendar",
          "date_property": "Due Date"
        }
      ],

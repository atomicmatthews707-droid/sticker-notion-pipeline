    {
      "name": "Projects",
      "properties": [
        {
          "name": "Project Name",
          "type": "title"
        },
        {
          "name": "Client",
          "type": "relation",
          "target_db": "Clients"
        },
        {
          "name": "Status",
          "type": "select"
        },
        {
          "name": "Pricing Model",
          "type": "select"
        },
        {
          "name": "Budget Fee",
          "type": "number"
        },
        {
          "name": "Start Date",
          "type": "date"
        },
        {
          "name": "Invoices",
          "type": "relation",
          "target_db": "Invoices"
        },
        {
          "name": "Total Invoiced",
          "type": "rollup",
          "relation_name": "Invoices",
          "rollup_property_name": "Subtotal",
          "function": "sum"
        }
      ],
      "views": [
        {
          "name": "Active Projects",
          "type": "table",
          "filter": {
            "property": "Status",
            "select": {
              "equals": "In Progress"
            }
          },
          "sorts": [
            {
              "property": "Start Date",
              "direction": "descending"
            }
          ]
        },
        {
          "name": "Project Pipeline",
          "type": "board",
          "group_by_property": "Status"
        },
        {
          "name": "Budget & Delivery Timeline",
          "type": "timeline",
          "date_property": "Start Date"
        }
      ],

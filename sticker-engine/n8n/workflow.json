{
  "name": "Sticker Engine schedule",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "minutes", "minutesInterval": 30 } ] } },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STICKER_ENGINE_URL }}/tick",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.ENGINE_API_TOKEN }}" } ] },
        "options": { "timeout": 3600000 }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "POST /tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0]
    },
    {
      "parameters": { "rule": { "interval": [ { "field": "days", "daysInterval": 1, "triggerAtHour": 20 } ] } },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Every evening",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STICKER_ENGINE_URL }}/digest/send",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.ENGINE_API_TOKEN }}" } ] }
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "POST /digest/send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 200]
    }
  ],
  "connections": {
    "Every 30 minutes": { "main": [ [ { "node": "POST /tick", "type": "main", "index": 0 } ] ] },
    "Every evening": { "main": [ [ { "node": "POST /digest/send", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
